{
  "id": "/",
  "name": "The Dugout",
  "short_name": "Dugout",
  "description": "Live IPL auctions with your friends. Pick a franchise, bid in real time and build your Playing XI.",
  "lang": "en-IN",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "any",
  "background_color": "#071a0f",
  "theme_color": "#071a0f",
  "categories": [
    "games",
    "sports",
    "entertainment"
  ],
  "prefer_related_applications": false,
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Create a room",
      "short_name": "Create",
      "url": "/?action=create&source=pwa",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Join a room",
      "short_name": "Join",
      "url": "/?action=join&source=pwa",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ],
  "screenshots": [
    {
      "src": "/screenshots/mobile-auction.jpg",
      "sizes": "780x1328",
      "type": "image/jpeg",
      "form_factor": "narrow",
      "label": "Live bidding on a phone"
    },
    {
      "src": "/screenshots/mobile-xi.jpg",
      "sizes": "780x1328",
      "type": "image/jpeg",
      "form_factor": "narrow",
      "label": "Build your Playing XI"
    },
    {
      "src": "/screenshots/wide-home.jpg",
      "sizes": "1440x900",
      "type": "image/jpeg",
      "form_factor": "wide",
      "label": "Create or join a room"
    },
    {
      "src": "/screenshots/wide-auction.jpg",
      "sizes": "1440x900",
      "type": "image/jpeg",
      "form_factor": "wide",
      "label": "The auction table"
    }
  ]
}
